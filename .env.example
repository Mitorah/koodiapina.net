# Koodiapina.net Environment Variables Example
# Copy this file to .env and fill in your actual values

# ===========================================
# Cloudflare Configuration
# ===========================================

# Your Cloudflare Account ID
# Find at: https://dash.cloudflare.com/ (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Cloudflare API Token (for deployments)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Needs permissions: Workers Scripts:Edit, D1:Edit
CLOUDFLARE_API_TOKEN=your-api-token-here

# ===========================================
# Database Configuration
# ===========================================

# Production D1 Database ID
# Find at: Cloudflare Dashboard → Workers & Pages → D1
D1_DATABASE_ID_PROD=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Local D1 Database ID (for development)
D1_DATABASE_ID_LOCAL=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# ===========================================
# API Configuration
# ===========================================

# Production API Worker URL
API_WORKER_URL_PROD=https://your-worker-name.your-subdomain.workers.dev

# Local API Worker URL (for development)
API_WORKER_URL_LOCAL=http://localhost:8787

# Allowed CORS Origin for production
ALLOWED_ORIGIN=https://your-domain.com

# ===========================================
# Frontend Configuration
# ===========================================

# Production frontend URL
FRONTEND_URL_PROD=https://your-domain.com

# Local frontend URL (for development)
FRONTEND_URL_LOCAL=http://localhost:5173

# ===========================================
# Cloudflare Access Configuration
# ===========================================

# Cloudflare Access protects the API worker endpoint
# Setup required at: Cloudflare Zero Trust → Access → Applications
# 
# Protected endpoints:
#   - your-worker-name.your-subdomain.workers.dev (API Worker)
#   - your-domain.com (Frontend)
#
# Access provides the CF-Access-Authenticated-User-Email header
# which is used for admin authentication checks

# ===========================================
# Notes
# ===========================================

# 1. Never commit .env file with real credentials to git
# 2. .env is already in .gitignore
# 3. For production, configure secrets in Cloudflare Dashboard:
#    Workers & Pages → Your Worker → Settings → Variables
# 4. Database IDs are in wrangler.toml (not sensitive)
# 5. Local development uses different database than production
